---
interface Props {
	title: string;
    description?: string;
}

const { 
    title = "APPTBOOKER | Never Miss An Appointment",
    description = "Lead handling on autopilot for gym owners."
} = Astro.props;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink font-sans antialiased selection:bg-accent selection:text-ink min-h-screen flex flex-col relative overflow-x-hidden">
        <!-- Global Background Texture -->
        <div class="fixed inset-0 bg-tech-dots bg-dots opacity-30 pointer-events-none z-0"></div>
        
		<Navbar />
        
        <main class="relative z-10 flex-grow">
		    <slot />
        </main>
        
		<Footer />
	</body>
</html>

<style is:global>
    /* Global Typography */
	h1, h2, h3, h4 {
		font-family: 'Outfit', sans-serif;
	}
    
    .font-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    /* Edgy/Premium Component Utilities */
    /* Edgy/Premium Component Utilities - Converted to standard CSS to avoid @apply build errors */
	.btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: white;
        border: 1px solid #2563eb;
        padding: 1rem 2rem;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        border-radius: 0.5rem;
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.1), 0 4px 6px -2px rgba(37, 99, 235, 0.05);
        transition: all 0.2s;
        text-align: center;
        display: inline-block;
        /* hover effects handled by tailwind classes usually, but here we can use css */
	}
    .btn-primary:hover {
        box-shadow: 0 20px 25px -5px rgba(37, 99, 235, 0.15), 0 10px 10px -5px rgba(37, 99, 235, 0.04);
        border-color: #84cc16; /* accent */
        transform: translateY(-0.25rem);
    }

	.btn-secondary {
        background: white;
        color: #0f172a;
        border: 1px solid #e2e8f0;
        padding: 1rem 2rem;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        border-radius: 0.5rem;
        transition: all 0.2s;
        text-align: center;
        display: inline-block;
	}
    .btn-secondary:hover {
        background: #f8fafc;
        border-color: #84cc16;
        color: #0f172a;
    }

    /* Re-mapping 'card-brutal' to 'card-premium' visually without changing component HTML */
    .card-brutal {
        background: white;
        border: 1px solid #e2e8f0;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.1), 0 4px 6px -2px rgba(37, 99, 235, 0.05);
        transition: all 0.2s;
    }
    .card-brutal:hover {
        box-shadow: 0 20px 25px -5px rgba(37, 99, 235, 0.15), 0 10px 10px -5px rgba(37, 99, 235, 0.04);
        transform: translateY(-0.25rem);
    }
    
    /* Utility for colored backgrounds */
    .bg-grid {
        background-color: #f8fafc;
    }
</style>
