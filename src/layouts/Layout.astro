---
interface Props {
	title: string;
    description?: string;
}

const { 
    title = "APPTBOOKER | Never Miss An Appointment",
    description = "Lead handling on autopilot for gym owners."
} = Astro.props;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink font-sans antialiased selection:bg-accent selection:text-ink min-h-screen flex flex-col relative overflow-x-hidden">
        <!-- Global Background Texture -->
        <div class="fixed inset-0 bg-tech-dots bg-dots opacity-30 pointer-events-none z-0"></div>
        
		<Navbar />
        
        <main class="relative z-10 flex-grow">
		    <slot />
        </main>
        
		<Footer />
	</body>
</html>

<style is:global>
    /* Global Typography */
	h1, h2, h3, h4 {
		font-family: 'Outfit', sans-serif;
	}
    
    .font-mono {
        font-family: 'JetBrains Mono', monospace;
    }

    /* Edgy/Premium Component Utilities */
	.btn-primary {
		@apply bg-gradient-to-br from-blue-600 to-blue-700 text-white border border-blue-600 px-8 py-4 font-display font-bold uppercase tracking-wide rounded-lg shadow-premium hover:shadow-premium-hover hover:border-lime-400 hover:-translate-y-1 transition-all text-center inline-block;
	}

	.btn-secondary {
		@apply bg-white text-ink border border-slate-200 px-8 py-4 font-mono font-bold uppercase tracking-wide rounded-lg hover:bg-slate-50 hover:border-accent hover:text-ink transition-all text-center inline-block;
	}

    /* Re-mapping 'card-brutal' to 'card-premium' visually without changing component HTML */
    .card-brutal {
        @apply bg-white border border-slate-200 p-8 rounded-2xl shadow-premium hover:shadow-premium-hover hover:-translate-y-1 transition-all;
    }
    
    /* Utility for colored backgrounds */
    .bg-grid {
        @apply bg-slate-50;
    }
</style>
