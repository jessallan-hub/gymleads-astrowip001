<section id="pricing" class="py-24 relative">
    <div class="max-w-4xl mx-auto px-6 text-center">
        
        <h2 class="text-4xl font-bold text-white mb-4">Simple, Transparent Pricing</h2>
        <p class="text-gray-400 mb-12">One missed job costs you more than our yearly fee.</p>

        <div class="glass-card border-neon/50 shadow-glow-xl relative overflow-visible transform transition-transform hover:scale-[1.01]">
            <div class="absolute -top-5 left-1/2 -translate-x-1/2 bg-neon text-ocean-950 font-bold px-6 py-2 rounded-full uppercase text-xs tracking-wider shadow-glow-sm">
                Most Popular
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-center p-8">
                <div class="text-left space-y-6">
                    <h3 class="text-2xl font-bold text-white">The "Set & Forget" Retainer</h3>
                    <div class="flex items-baseline gap-2">
                        <span class="text-5xl font-bold text-neon font-mono">$500</span>
                        <span class="text-gray-400">/ month</span>
                    </div>
                    <p class="text-sm text-gray-400">+ $1,000 one-time setup (Custom Training your Digital Staff)</p>
                    
                    <a href="#" class="btn-primary block text-center w-full">Start Your Free Trial</a>
                    <p class="text-xs text-gray-500 text-center mt-2">More bookings in 30 days or you don’t pay.</p>
                </div>

                <div class="text-left border-t md:border-t-0 md:border-l border-white/10 pt-8 md:pt-0 md:pl-8 space-y-4">
                    <ul class="space-y-3">
                        <li class="flex items-center gap-3 text-sm text-gray-300">
                            <span class="text-neon">✓</span> 24/7 Call & SMS Handling
                        </li>
                            <li class="flex items-center gap-3 text-sm text-gray-300">
                            <span class="text-neon">✓</span> Direct Calendar Booking
                        </li>
                            <li class="flex items-center gap-3 text-sm text-gray-300">
                            <span class="text-neon">✓</span> Local "Northern Rivers" Dialect
                        </li>
                            <li class="flex items-center gap-3 text-sm text-gray-300">
                            <span class="text-neon">✓</span> Unlimited Conversations
                        </li>
                            <li class="flex items-center gap-3 text-sm text-gray-300">
                            <span class="text-neon">✓</span> Dedicated Account Manager
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
