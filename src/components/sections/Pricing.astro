---
<section id="pricing" class="py-24 px-6 bg-slate-900 text-white relative overflow-hidden">
    <!-- Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600 rounded-full blur-[120px] opacity-20 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10">
         <div class="bg-white/5 backdrop-blur-lg border border-white/10 p-8 md:p-12 rounded-3xl shadow-2xl relative">
            <div class="absolute top-0 right-0 bg-accent text-white px-6 py-2 font-display font-bold uppercase rounded-bl-2xl rounded-tr-2xl text-sm tracking-wider shadow-lg">
                Public Beta
            </div>
            
            <h2 class="font-display text-4xl font-bold uppercase mb-8">Flat Rate Access</h2>
            <div class="flex flex-col md:flex-row justify-between items-end gap-8">
                <div>
                    <div class="flex items-baseline gap-2">
                         <div class="text-6xl font-black font-display mb-2 text-white">$499</div>
                         <div class="text-xl text-slate-400 font-medium">USD</div>
                    </div>
                    <p class="font-mono text-slate-400 text-sm">/ MONTHLY RETAINER</p>
                </div>
                <ul class="font-sans text-sm space-y-4">
                    <li class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">✓</span> 
                        <span class="text-slate-200 font-medium">UNLIMITED CALLS</span>
                    </li>
                    <li class="flex items-center gap-3">
                         <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">✓</span> 
                        <span class="text-slate-200 font-medium">UNLIMITED BOOKINGS</span>
                    </li>
                    <li class="flex items-center gap-3">
                         <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">✓</span> 
                        <span class="text-slate-200 font-medium">DEDICATED SETUP</span>
                    </li>
                </ul>
            </div>
            
            <a href="#cta" class="block w-full bg-white text-ink hover:bg-slate-200 font-display font-bold text-xl uppercase text-center py-5 mt-12 rounded-xl transition-colors shadow-lg">
                Secure Your Spot
            </a>
            
            <p class="text-center text-xs text-slate-500 mt-6">No lock-in contracts. Cancel anytime.</p>
         </div>
    </div>
</section>
