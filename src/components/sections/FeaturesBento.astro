<section class="py-24">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-white mb-12 text-center font-mono">Mission Capabilities</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[600px]">
            
            <!-- Large Feature -->
            <div class="md:col-span-2 md:row-span-2 glass-card flex flex-col justify-between overflow-hidden relative group">
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-ocean-950/90 z-10"></div>
                <div class="relative z-20">
                    <h3 class="text-2xl font-bold text-white mb-2">Smart Scheduling</h3>
                    <p class="text-gray-400">Syncs directly with your Google/Outlook calendar. No double bookings. Ever.</p>
                </div>
                <div class="mt-8 bg-ocean-800/50 border border-white/5 p-4 rounded text-xs font-mono text-neon border-l-4 border-l-neon w-fit z-20">
                    {">"} Appointment Confirmed <br>
                    {">"} Tuesday, 10:00 AM <br>
                    {">"} Site: 12 Shelley St, Lennox
                </div>
                <!-- Decorative Graphic -->
                    <div class="absolute right-0 bottom-0 w-48 h-48 bg-neon/5 rounded-full blur-3xl"></div>
            </div>

            <!-- Feature 2 -->
            <div class="md:col-span-2 glass-card flex flex-col justify-center">
                <h3 class="text-xl font-bold text-white mb-2">Omni-Channel Command</h3>
                <p class="text-gray-400 text-sm">Voice, SMS, Facebook Messenger, Instagram, Email. One brain handling all inputs.</p>
            </div>

            <!-- Feature 3 -->
            <div class="md:col-span-1 glass-card border-neon/20">
                <h3 class="text-lg font-bold text-white mb-2">Local Dialect</h3>
                <p class="text-gray-400 text-xs">Trained to understand "arvo", "reno", and Northern Rivers geography.</p>
            </div>

            <!-- Feature 4 -->
            <div class="md:col-span-1 glass-card">
                <h3 class="text-lg font-bold text-white mb-2">CRM Sync</h3>
                <p class="text-gray-400 text-xs">Pushes lead data straight into your ServiceM8, Tradify, or HubSpot.</p>
            </div>
        </div>
    </div>
</section>
