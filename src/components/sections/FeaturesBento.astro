---
---
<section id="features" class="py-24 px-6 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-4 md:grid-rows-2 gap-6 h-auto md:h-[600px]">
            <!-- Calendar Command -->
            <div class="md:col-span-2 md:row-span-2 card-premium flex flex-col justify-between overflow-hidden relative">
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-100 rounded-full blur-3xl -mr-10 -mt-10 opacity-50"></div>
                <div class="relative z-10">
                    <h3 class="font-display font-bold text-3xl uppercase mb-2 text-ink">Calendar Command</h3>
                    <p class="text-sm font-medium text-muted">Direct write access to your schedule. No double-bookings.</p>
                </div>
                <!-- Mini UI Mock -->
                 <div class="mt-8 border border-slate-200 bg-slate-50 rounded-xl p-4 font-mono text-xs shadow-inner relative z-10">
                    <div class="flex gap-2 mb-2">
                        <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                        <div class="w-2 h-2 rounded-full bg-slate-300"></div>
                    </div>
                    <div class="space-y-1 text-slate-500">
                        <div>> CHECK_AVAILABILITY(TODAY)</div>
                        <div class="text-green-600">> SLOT_FOUND: 17:00</div>
                        <div class="text-blue-600">> BOOKING_CONFIRMED</div>
                    </div>
                </div>
            </div>
            
            <!-- Lead Nurture -->
            <div class="md:col-span-2 bg-gradient-to-br from-slate-900 to-slate-800 text-white p-8 rounded-2xl shadow-premium relative overflow-hidden group">
                 <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-10"></div>
                <h3 class="font-display font-bold text-2xl uppercase mb-2 group-hover:text-accent transition-colors">Lead Nurture</h3>
                <p class="text-sm text-slate-300">We don't just answer. We follow up. <br>D1, D3, D7 sequences baked in.</p>
            </div>
            
            <!-- CRM Sync -->
            <div class="md:col-span-1 bg-accent text-white p-8 rounded-2xl shadow-premium flex flex-col justify-center text-center">
                <h3 class="font-display font-bold text-xl uppercase mb-2">CRM Sync</h3>
                <p class="text-xs font-bold font-mono bg-white/20 p-2 rounded-lg inline-block">Mindbody</p>
                <p class="text-xs font-bold font-mono bg-white/20 p-2 rounded-lg inline-block mt-2">Glofox</p>
            </div>
            
            <!-- SMS Blast -->
            <div class="md:col-span-1 card-premium flex flex-col justify-center text-center">
                <h3 class="font-display font-bold text-xl uppercase mb-2 text-ink">SMS Blast</h3>
                <p class="text-xs font-bold text-muted">Reactivate dead leads.</p>
                <button class="mt-4 bg-slate-100 text-slate-600 text-xs font-bold py-2 rounded-lg hover:bg-slate-200 transition-colors">Send Campaign</button>
            </div>
        </div>
    </div>
</section>
