---
---
<section class="py-24 px-6 border-t border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto">
        <h2 class="font-display text-6xl font-black uppercase mb-16 text-center tracking-tight text-ink">System Logic</h2>
        
        <div class="grid md:grid-cols-3 gap-8 text-center md:text-left">
            <!-- Step 1 -->
            <div class="p-8 rounded-2xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-premium transition-all group relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10 font-display font-black text-6xl text-slate-300">01</div>
                <div class="w-12 h-12 bg-blue-100 text-primary rounded-xl flex items-center justify-center mb-6 text-xl font-bold">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="font-display font-bold text-xl uppercase mb-3 text-ink">Trigger</h3>
                <p class="text-sm font-medium text-muted">Inbound Call, SMS, or DM received. System activates in &lt; 1 second.</p>
            </div>
            <!-- Step 2 -->
            <div class="p-8 rounded-2xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-premium transition-all group relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10 font-display font-black text-6xl text-slate-300">02</div>
                <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center mb-6 text-xl font-bold">
                     <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                </div>
                <h3 class="font-display font-bold text-xl uppercase mb-3 text-ink">Process</h3>
                <p class="text-sm font-medium text-muted">AI Agent engages natural conversation logic. Qualifies intent (Join? Cancel? Info?).</p>
            </div>
            <!-- Step 3 -->
            <div class="p-8 rounded-2xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-premium transition-all group relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10 font-display font-black text-6xl text-slate-300">03</div>
                <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mb-6 text-xl font-bold">
                     <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="font-display font-bold text-xl uppercase mb-3 text-ink">Execute</h3>
                <p class="text-sm font-medium text-muted">Appointment synced to CRM. Confirmation sent. Owner notified via Push.</p>
            </div>
        </div>
    </div>
</section>
