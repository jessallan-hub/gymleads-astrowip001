<section class="py-24 bg-gradient-to-b from-ocean-900 to-ocean-950">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row gap-12 items-center">
        <div class="flex-1">
            <div class="text-neon font-mono text-sm mb-2">// DETECTED REVENUE UPLIFT</div>
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">"I used to spend 2 hours a night returning calls."</h2>
            <p class="text-xl text-gray-300 italic mb-8">
                "Now I just check my calendar in the morning. allconvos booked 12 extra jobs in the first month. That's $15k I would have missed."
            </p>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-600 rounded-full"></div> <!-- Placeholder Avatar -->
                <div>
                    <div class="font-bold text-white">Dave M.</div>
                    <div class="text-sm text-gray-500 font-mono">Owner, Lennox Level Plumbing</div>
                </div>
            </div>
        </div>
        <div class="flex-1">
            <div class="bg-ocean-950 p-6 border border-white/10 rounded-sm relative">
                <div class="absolute -top-4 -right-4 bg-neon text-ocean-950 font-bold px-4 py-2 font-mono text-sm transform rotate-3 shadow-glow-md">
                    +32% REVENUE
                </div>
                <!-- Stats Stack -->
                <div class="space-y-4">
                    <div class="flex justify-between items-center border-b border-white/5 pb-2">
                        <span class="text-gray-400 font-mono text-sm">Missed Calls</span>
                        <span class="text-red-400 font-mono">0</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-white/5 pb-2">
                        <span class="text-gray-400 font-mono text-sm">Auto-Replies</span>
                        <span class="text-white font-mono">143</span>
                    </div>
                        <div class="flex justify-between items-center border-b border-white/5 pb-2">
                        <span class="text-gray-400 font-mono text-sm">Appointments</span>
                        <span class="text-neon font-bold font-mono">42</span>
                    </div>
                </div>
                <div class="mt-6 aspect-video bg-ocean-900 rounded border border-white/5 flex items-center justify-center text-gray-600 font-mono text-xs">
                    [REVENUE GRAPH PLACEHOLDER]
                </div>
            </div>
        </div>
    </div>
</section>
