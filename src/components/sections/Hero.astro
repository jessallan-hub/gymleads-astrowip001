---
---
<section class="relative min-h-screen flex items-center pt-20">
    <!-- Glow Orbs (using tokens if possible, or keeping arbitrary for distinct effect) -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-neon/10 rounded-full blur-[100px] pointer-events-none mix-blend-screen animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none mix-blend-screen"></div>

    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center relative z-10">
        <div class="space-y-8">
            <div class="inline-flex items-center space-x-2 bg-ocean-800/50 border border-white/10 px-3 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
                <span class="text-xs font-mono text-neon uppercase tracking-wider">Operational 24/7/365</span>
            </div>
            
            <h1 class="text-5xl lg:text-7xl font-bold leading-[0.9] text-white">
                STOP MISSING <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon to-emerald-400">CALLS.</span> <br>
                START MAKING <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon to-emerald-400">MONEY.</span>
            </h1>
            
            <p class="text-xl text-gray-400 max-w-lg leading-relaxed">
                The AI receptionist that answers every call, qualifies every lead, and books jobs 24/7—so you can get back on the tools.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <a href="#pricing" class="btn-primary text-center">
                    Build My AI Agent
                </a>
                <a href="#demo" class="btn-secondary text-center group">
                     Listen to Demo <span class="group-hover:translate-x-1 inline-block transition-transform">-></span>
                </a>
            </div>

            <p class="text-sm font-mono text-gray-500">
                // No complex setup. No "tech bro" jargon. Just results.
            </p>
        </div>

        <!-- Hero Visual: Mission Control Interface -->
        <div class="relative hidden lg:block">
            <div class="absolute -inset-1 bg-gradient-to-r from-neon to-blue-600 rounded-lg blur opacity-20"></div>
            <div class="relative bg-ocean-900 border border-white/10 rounded-lg shadow-2xl overflow-hidden">
                <div class="bg-ocean-950 border-b border-white/10 px-4 py-3 flex items-center justify-between">
                    <div class="flex space-x-2">
                        <div class="w-3 h-3 rounded-full bg-red-500"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500"></div>
                    </div>
                    <div class="font-mono text-xs text-gray-500">live_agent_v2.0.exe</div>
                </div>
                
                <div class="p-6 space-y-4 font-mono text-sm">
                    <!-- Chat Message 1 -->
                    <div class="flex items-start space-x-4 animate-fade-in" style="animation-delay: 0.1s;">
                        <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0">👤</div>
                        <div class="bg-ocean-800 p-3 rounded-lg rounded-tl-none border border-white/5 text-gray-300">
                            <p>Hey, do you guys do emergency plumbing in Ballina?</p>
                        </div>
                    </div>

                    <!-- Chat Message 2 -->
                    <div class="flex items-start space-x-4 justify-end animate-fade-in" style="animation-delay: 0.8s; opacity: 0; animation-fill-mode: forwards;">
                        <div class="bg-neon/10 p-3 rounded-lg rounded-tr-none border border-neon/20 text-neon">
                            <p>We sure do! We have a tech available in Ballina this afternoon. Is it urgent?</p>
                        </div>
                        <div class="w-8 h-8 rounded-full bg-neon flex items-center justify-center shrink-0 text-ocean-950 font-bold">AI</div>
                    </div>

                     <!-- Chat Message 3 -->
                     <div class="flex items-start space-x-4 animate-fade-in" style="animation-delay: 2s; opacity: 0; animation-fill-mode: forwards;">
                        <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center shrink-0">👤</div>
                        <div class="bg-ocean-800 p-3 rounded-lg rounded-tl-none border border-white/5 text-gray-300">
                            <p>Yeah, hot water system just burst. Water everywhere.</p>
                        </div>
                    </div>

                    <!-- Notification Overlay -->
                    <div class="absolute bottom-6 right-6 left-6 bg-ocean-800 border-l-4 border-neon p-4 shadow-2xl animate-fade-in" style="animation-delay: 3s; opacity: 0; animation-fill-mode: forwards;">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-gray-500 uppercase font-bold mb-1">Status Update</p>
                                <p class="text-white font-bold">New Job Booked: $450+</p>
                                <p class="text-xs text-gray-400 mt-1">Calendar Updated • SMS Sent to Dave</p>
                            </div>
                            <div class="bg-neon/20 p-2 rounded text-neon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
