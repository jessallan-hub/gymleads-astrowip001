---
---
<header class="relative py-32 px-6 overflow-hidden bg-ink border-b border-primary/20">
    <!-- Gritty Image Background (Radical) -->
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=2940&auto=format&fit=crop" 
             class="w-full h-full object-cover opacity-40 grayscale mix-blend-luminosity" 
             alt="Hardcore Gym Background" />
        <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/90 to-blue-900/40 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-tech-grid opacity-20 bg-grid"></div>
    </div>
    
    <!-- Edgy Corner Markers (Neon) -->
    <div class="absolute top-0 left-0 p-6 text-accent animate-pulse-slow">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 1V9M1 1H9" stroke-width="4"/></svg>
    </div>
    <div class="absolute bottom-0 right-0 p-6 text-accent animate-pulse-slow">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M23 23V15M23 23H15" stroke-width="4"/></svg>
    </div>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center relative z-10">
        <!-- Text Content -->
        <div class="space-y-8 flex flex-col items-start text-left">
            <div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-2 backdrop-blur-md -skew-x-12">
                <span class="w-2 h-2 rounded-sm bg-accent animate-ping"></span>
                <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-accent skew-x-12">System_Overclocked</span>
            </div>
            
            <h1 class="font-display font-black text-4xl lg:text-5xl leading-[0.9] uppercase tracking-tighter italic relative">
                <span class="block text-slate-100 relative z-20 mb-1 drop-shadow-md">The #1 Solution for</span>
                <span class="block text-white drop-shadow-[0_0_15px_rgba(37,99,235,0.5)] relative z-10">Gym Owners Who Thrive on Bookings</span>
            </h1>
            
            <p class="text-xl text-slate-300 max-w-lg font-medium leading-relaxed font-mono border-l-4 border-accent pl-6">
                // Lead handling on autopilot. <br>
                <span class="text-white">We answer calls, qualify leads, and book classes while you handle the gym floor.</span>
            </p>
            
            <div class="flex flex-col sm:flex-row gap-6 pt-6 w-full">
                <a href="#cta" class="btn-primary text-xl px-10 py-6 skew-x-[-10deg] hover:skew-x-0 transition-transform bg-accent hover:bg-white text-ink border-none hover:text-ink">
                    <span class="block skew-x-[10deg]">Book A Demo</span>
                </a>
                <a href="#" class="px-10 py-6 font-mono font-bold uppercase tracking-widest text-white border border-white/20 hover:border-accent hover:text-accent transition-colors skew-x-[-10deg]">
                     <span class="block skew-x-[10deg]">Call Agent -></span>
                </a>
            </div>
            
            <div class="pt-4 flex items-center gap-2 opacity-60 font-mono text-xs uppercase tracking-widest text-slate-400">
                <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                Syncs with MindBody & Glofox
            </div>
        </div>

        <!-- Radical UI Visual -->
        <div class="relative w-full perspective-1000">
             <div class="absolute -inset-10 bg-accent/20 blur-[100px] rounded-full animate-pulse-slow mix-blend-screen"></div>
            <div class="relative bg-ink/80 backdrop-blur-xl border border-white/10 p-2 transform rotate-2 hover:rotate-0 transition-all duration-500 ring-1 ring-white/20">
                <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2940&auto=format&fit=crop" class="w-full h-auto opacity-50 grayscale mix-blend-overlay absolute inset-0 z-0">
                <div class="relative z-10 p-8 space-y-6">
                        <div class="bg-blue-600 text-white p-4 rounded-2xl rounded-tr-none shadow-premium max-w-[80%]">
                            <p class="text-xs font-bold text-blue-200 mb-1 uppercase tracking-wider">GymLeads_</p>
                            <p class="text-sm">$25 per session! But first class is free. Want me to grab you a spot?</p>
                        </div>
                     <div class="space-y-4 font-mono text-sm">
                        <div class="bg-white/5 p-4 border-l-2 border-slate-500 text-slate-400">
                            > "Do you have 6am classes?"
                        </div>
                        <div class="bg-blue-600/20 p-4 border-l-2 border-accent text-white">
                            > "Yes. 5 spots left. Want me to hold one?"
                        </div>
                         <div class="bg-accent/10 p-4 text-accent font-bold text-xs uppercase tracking-widest flex items-center gap-2">
                             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                             Lead_Captured [24ms]
                        </div>
                     </div>
                </div>
            </div>
        </div>
    </div>
</header>
